{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", ".env.test"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "VALKEY_URL",
    "VALKEY_PASSWORD",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "AWS_ENDPOINT",
    "AWS_CDN_URL",
    "AWS_S3_BUCKET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_MAPS_SERVER_KEY",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "JWT_SECRET",
    "LOG_LEVEL",
    "SENTRY_DSN",
    "NEXT_PUBLIC_WS_URL",
    "WS_PORT",
    "FIRST_USER_ADMIN",
    "WORKER_EMAIL_CONCURRENCY",
    "WORKER_EMAIL_RATE_LIMIT",
    "WORKER_WEBHOOK_CONCURRENCY",
    "WORKER_WEBHOOK_RATE_LIMIT",
    "DIRECT_URL",
    "RESEND_API_KEY",
    "S3_BUCKET",
    "S3_REGION",
    "RESEND_FROM_EMAIL",
    "OUTBOX_POLL_INTERVAL_MS",
    "WORKER_ID"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["test-results/**"]
    },
    "db:generate": {
      "cache": true,
      "outputs": ["packages/shared/src/db/migrations/**"]
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "worker": {
      "cache": false,
      "persistent": true
    },
    "ws": {
      "cache": false,
      "persistent": true
    }
  }
}
